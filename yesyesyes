local function makeSlider(name, min, max, default, callback)
    local cont = Instance.new("Frame")
    cont.Size = UDim2.new(1, -14, 0, 48)
    cont.BackgroundTransparency = 1
    cont.Parent = scrollFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Text = name .. " [" .. string.format("%.2f", default) .. "]"
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextColor3 = Color3.new(1, 1, 1)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = cont

    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, 0, 0, 16)
    barBg.Position = UDim2.new(0, 0, 0, 24)
    barBg.BackgroundColor3 = Color3.fromRGB(35, 38, 52)
    barBg.Parent = cont

    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 8)
    bgCorner.Parent = barBg

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    barFill.Parent = barBg

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 8)
    fillCorner.Parent = barFill

    local value = default
    local mouseDown = false

    local function update(posX)
        local frac = math.clamp(posX / barBg.AbsoluteSize.X, 0, 1)
        value = min + frac * (max - min)
        barFill.Size = UDim2.new(frac, 0, 1, 0)
        label.Text = name .. " [" .. string.format("%.2f", value) .. "]"
        callback(value)
    end

    barBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            mouseDown = true
            update(input.Position.X - barBg.AbsolutePosition.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if mouseDown and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X - barBg.AbsolutePosition.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            mouseDown = false
        end
    end)

    return barFill
end

local function makeButton(name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -14, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(32, 36, 50)
    btn.Text = name
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.AutoLocalize = false
    btn.Parent = scrollFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(callback)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(55, 60, 82) }):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(32, 36, 50) }):Play()
    end)
end

