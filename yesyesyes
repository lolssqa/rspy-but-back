local hue = 0
RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.35) % 1
    local rainbowCol = Color3.fromHSV(hue, 0.85, 1)

    fill1.BackgroundColor3 = rainbowCol
    fill2.BackgroundColor3 = Color3.fromHSV((hue + 0.15) % 1, 0.85, 1)
    fill3.BackgroundColor3 = Color3.fromHSV((hue + 0.30) % 1, 0.85, 1)
    fill4.BackgroundColor3 = Color3.fromHSV((hue + 0.45) % 1, 0.85, 1)
    fill5.BackgroundColor3 = Color3.fromHSV((hue + 0.60) % 1, 0.85, 1)
    titleText.TextColor3 = rainbowCol
    circleToggle.BackgroundColor3 = rainbowCol

    if math.random() < 0.07 then
        spawnSnowflake()
    end

    for i = #snowParticles, 1, -1 do
        local obj = snowParticles[i]
        local inst = obj.inst
        inst.Position += UDim2.new(0, obj.speedX * dt, 0, obj.speedY * dt)

        if inst.Position.Y.Scale > 1.05 then
            inst:Destroy()
            table.remove(snowParticles, i)
        end
    end
end)

local dragToggle = false
local dragStart
local startPos

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function()
    dragToggle = false
end)
