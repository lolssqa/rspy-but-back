end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartPos
        mainFrame.Position = UDim2.new(
            frameStartPos.X.Scale,
            frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,
            frameStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function()
    dragging = false
end)

local function cacheOrigin(char)
    table.clear(originPartSize)

    local r15Map = {
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
        LeftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("LeftArm"),
        RightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("RightArm"),
        LeftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("LeftLeg"),
        RightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("RightLeg")
    }

    for key, part in pairs(r15Map) do
        if part and part:IsA("BasePart") then
            originPartSize[key] = part.Size
        end
    end
end

local function refreshPartScale()
    local char = localPlr.Character
    if not char then return end
    if next(originPartSize) == nil then cacheOrigin(char) end

    local r15Map = {
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
        LeftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("LeftArm"),
        RightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("RightArm"),
        LeftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("LeftLeg"),
        RightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("RightLeg")
    }

    for key, part in pairs(r15Map) do
        if part and originPartSize[key] then
            part.Size = originPartSize[key] * scaleData[key]
        end
    end
end

local function makeSlider(labelName, dataKey, min, max, default)
    local cont = Instance.new("Frame")
    cont.Size = UDim2.new(1, -10, 0, 44)
    cont.BackgroundTransparency = 1
    cont.Parent = scrollFrame

    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1, 0, 0, 17)
    lab.Text = labelName .. " [" .. string.format("%.2f", default) .. "]"
    lab.Font = Enum.Font.Gotham
    lab.TextSize = 11
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.BackgroundTransparency = 1
    lab.TextColor3 = Color3.new(1, 1, 1)
    lab.Parent = cont

    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, 0, 0, 12)
    barBg.Position = UDim2.new(0, 0, 0, 22)
    barBg.BackgroundColor3 = Color3.fromRGB(40, 44, 60)
    barBg.Parent = cont

    local c1 = Instance.new("UICorner")
    c1.CornerRadius = UDim.new(0, 6)
    c1.Parent = barBg

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(70, 160, 255)
    fill.Parent = barBg

    local c2 = Instance.new("UICorner")
    c2.CornerRadius = UDim.new(0, 6)
    c2.Parent = fill

    table.insert(sliderFills, fill)

    local val = default
    local down = false

    local function update(xpos)
        local f = math.clamp(xpos / barBg.AbsoluteSize.X, 0, 1)
        val = min + f * (max - min)
        fill.Size = UDim2.new(f, 0, 1, 0)
        lab.Text = labelName .. " [" .. string.format("%.2f", val) .. "]"
        scaleData[dataKey] = val
        refreshPartScale()
    end

    barBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            down = true
            update(input.Position.X - barBg.AbsolutePosition.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if down and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X - barBg.AbsolutePosition.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            down = false
        end
    end)
end

