local function HidePanel()
	local exitAnim = TweenService:Create(MainFrame,exitTween,{Position=UDim2.new(1,20,0,12)})
	exitAnim:Play()
	exitAnim.Completed:Connect(function()
		MainFrame.Visible = false
	end)
end

local function LoadGameZone()
	if gameZoneLoaded then
		StatusText.Text = "游戏专区：已加载"
		StatusText.TextColor3 = Color3.new(0,1,0)
		task.wait(0.6)
		HidePanel()
		return
	end
	StatusText.Text = "游戏专区：加载中..."
	StatusText.TextColor3 = Color3.new(1,1,0)
	task.spawn(function()
		local ok,data = pcall(game.HttpGet,game,"https://github.com/lolssqa/rspy-but-back/releases/download/game/LU_Hub_game")
		if not ok then
			StatusText.Text = "加载失败"
			StatusText.TextColor3 = Color3.new(1,0,0)
			warn("专区下载失败：",data)
			task.wait(0.8)
			HidePanel()
			return
		end
		local loadOk,func = pcall(loadstring,data)
		if not loadOk then
			StatusText.Text = "脚本解析失败"
			StatusText.TextColor3 = Color3.new(1,0,0)
			warn("脚本编译报错：",func)
			task.wait(0.8)
			HidePanel()
			return
		end
		gameZoneEnv = getfenv(func)
		func()
		gameZoneLoaded = true
		StatusText.Text = "游戏专区：加载完成 ✅"
		StatusText.TextColor3 = Color3.new(0,1,0)
		task.wait(0.6)
		HidePanel()
	end)
end

local function UnloadGameZone()
	if not gameZoneLoaded then
		StatusText.Text = "游戏专区：未加载"
		StatusText.TextColor3 = Color3.new(0.9,0.9,0.9)
		task.wait(0.6)
		HidePanel()
		return
	end
	StatusText.Text = "游戏专区：已卸载"
	StatusText.TextColor3 = Color3.new(0.9,0.9,0.9)
	gameZoneLoaded = false
	gameZoneEnv = nil
	task.wait(0.6)
	HidePanel()
end

LoadBtn.MouseButton1Click:Connect(LoadGameZone)
UnloadBtn.MouseButton1Click:Connect(UnloadGameZone)
